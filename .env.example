# ═══════════════════════════════════════════════════════════════
# stage-57 — sinshin-food-delivery — فاز دیپلوی
# مسیر مقصد: .env.example (ریشه)
# وضعیت: جایگزینی کامل فایل موجود
# کامیت پیشنهادی: stage fifty-seven
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# سین‌شین — فایل کانفیگ تولید (تک‌فایل) — کالیبره برای ۸ هسته/۱۶GB
# کپی کن:  cp .env.example .env
#
# این تنها فایلی است که docker compose می‌خواند (سرویس‌های
# api / migrate / seed / seed-deploy / postgres / backup در استک تولید).
# راهنمای گام‌به‌گام کامل توسعه و تولید: README.md (بخش ۱ و ۲).
# جدول کامل و شرح تک‌تک متغیرها: docs/REFERENCE.md (بخش ۲).
#
# نشانه‌ها:
#   🔒 = خودت باید مقدار بگذاری (بدون آن تولید بالا نمی‌آید/کار نمی‌کند)
#   💡 = پیش‌فرض معقول دارد؛ فقط اگر خواستی عوض کن
#
# ⚠ سرویس api با مقدار غلط/ناقص بوت نمی‌شود (fail-fast عمدی)
#   و در لاگ دقیقاً می‌گوید چه چیزی را اصلاح کنی.
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# ۱) اجباری — بدون این‌ها تولید بالا نمی‌آید
# ═══════════════════════════════════════════════════════════════

# ─── 🔒 دامنه (بدون https:// — Caddy با همین نام TLS می‌گیرد) ───
# دامنه‌ی اصلی با پیشوند؛ دامنه‌ی بدون پیشوند فقط ریدایرکت می‌شود.
DOMAIN=www.sinshin-foodpark.ir
APEX_DOMAIN=sinshin-foodpark.ir
# 🔒 ایمیل واقعی خودت — Let's Encrypt هشدارهای گواهی را به همین می‌فرستد
# (روی dev@sinshin.localhost بمانی، فقط ایمیل‌های گواهی گم می‌شوند):
ACME_EMAIL=dev@sinshin.localhost
# 🔒 زیردامنه‌ی گیتا (CI/CD) — باید «عینِ» مقدار GIT_DOMAIN در
# deploy/gitea/.env باشد؛ رکورد DNS: نوع A، نام git، مقدار IP سرور.
GIT_DOMAIN=git.sinshin-foodpark.ir

# ─── 🔒 پستگرس ───
POSTGRES_USER=sinshin
# 🔒 پسورد دیتابیس — بساز: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sinshin
# 🔒 باید همان پسورد بالا داخلش باشد (user/db هم هماهنگ):
DATABASE_URL=postgres://sinshin:CHANGE_ME@postgres:5432/sinshin

# ─── 🔒 امنیت نشست‌ها ───
# کلید امضای توکن‌های ورود — بساز: openssl rand -base64 48
# (حداقل ۳۲ کاراکتر؛ لو رفتنش یعنی جعل نشست)
JWT_SECRET=

# ─── 🔒 ادمین‌ها ───
# شماره‌هایی که با اولین ورود ابرمدیر می‌شوند (با کاما جدا).
# خالی = پنل ادمین عملاً بی‌صاحب می‌ماند.
SUPER_ADMIN_PHONES=09118067283,09039526091

# ─── 🔒 پیامک — SMS.ir (اجباری در تولید) ───
# فقط دو مقدار مجاز:  console (فقط لاگ، ممنوع در تولید)  |  real
# درگاه SMS.ir با «قالب‌های تأییدشده» کار می‌کند (verify API):
#   POST https://api.sms.ir/v1/send/verify   هدر: x-api-key
#   بدنه: { mobile, templateId, parameters: [{name, value}] }
# ⚠️ URL گزارش در «متن قالب» است — بک‌اند فقط TOKEN می‌فرستد.
# 🔒 کلید از پنل SMS.ir: بخش «کلیدهای API» (IP سرور را whitelist کرده‌ای)
SMS_PROVIDER=real
SMS_IR_API_KEY=
# 🔒 شناسه‌ی قالب‌ها (پنل SMS.ir → ارسال سریع → قالب‌ها → ستون «شناسه»)
SMS_TEMPLATE_ID_OTP=934536
# قالب پیک — هنوز نساختی؟ خالی بگذار؛ همان قالب otp استفاده می‌شود
SMS_TEMPLATE_ID_COURIER_OTP=
SMS_TEMPLATE_ID_DAILY=698601
SMS_TEMPLATE_ID_WEEKLY=825599
SMS_TEMPLATE_ID_HEALTH=107393
# 💡 مهلت فراخوانی درگاه (میلی‌ثانیه)
#SMS_TIMEOUT_MS=10000

# ─── 🔒 درگاه پرداخت (اجباری در تولید) ───
# GATEWAY_MODE فقط «فعال/غیرفعال بودن درگاه واقعی» را تعیین می‌کند؛
# انتخابِ درگاه در صفحه‌ی تسویه توسط مشتری است:
#   direct یا indirect = درگاه واقعی فعال (هر دو یکسان عمل می‌کنند)
#   mock               = فقط توسعه — در تولید بوت را می‌کُشد
# چهار درگاه آماده است؛ 🔒 کلید هر کدام را که ارائه می‌کنی بده:
#   زرین‌پال          → ZARINPAL_MERCHANT_ID (کد ۳۶ کاراکتری پنل زرین‌پال)
#   پی‌ایر            → PAYIR_API_KEY (کلید پنل پی‌ایر)
#   بانک سامان        → SEP_TERMINAL_ID (کد ترمینال ۸ رقمی از پنل sep.ir)
#   بانک ملت          → MELLAT_TERMINAL_ID + MELLAT_USERNAME + MELLAT_PASSWORD
#                       (از پنل به‌پرداخت بعد از فعال‌سازی ترمینال)
# نکته: آدرس برگشت همه‌ی درگاه‌ها خودکار از DOMAIN ساخته می‌شود؛ در پنل
# زرین‌پال آدرس سایت را ثبت کن تا callback رد نشود.
# تست بدون پول: زرین‌پال سندباکس رسمی دارد (ZARINPAL_SANDBOX پایین‌تر)؛
# پی‌ایر با کلید test؛ سامان/ملت (شاپرک) سندباکس عمومی ندارند — ترمینال
# تستیِ بانک روی همان آدرس تولید. شرح کامل: docs/REFERENCE.md بخش ۷.
GATEWAY_MODE=mock
ZARINPAL_MERCHANT_ID=
PAYIR_API_KEY=
SEP_TERMINAL_ID=
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=

# ═══════════════════════════════════════════════════════════════
# ۲) اختیاری — پیش‌فرض معقول دارند؛ فقط اگر خواستی عوض کن
# ═══════════════════════════════════════════════════════════════

# ─── بکاپ روزانه‌ی دیتابیس (سرویس backup) ───
# 💡 مسیر بکاپ روی «میزبان» — روی HDD شما (گام ۲ README پوشه‌اش را ساخته).
# compose همین مسیر را داخل کانتینر backup مونت می‌کند. اگر پوشه‌ی دیگری
# می‌خواهی، هم‌زمان restore-drill و مستندات را هم عوض کن.
BACKUP_DIR_HOST=/srv/hdd/sinshin/backups
# 💡 ساعت اجرا به وقت تهران (۵ صبح = بعد از job نگهداشت ۰۴:۳۰)
BACKUP_HOUR=5
# 💡 تعداد نسخه‌ای که نگه داشته می‌شود (۳۰ = یک ماه آرشیو روی HDD)
BACKUP_KEEP=30
# بازیابی (روی هاست — گام ۱۵ README):
#   docker compose stop api web
#   gunzip -c /srv/hdd/sinshin/backups/sinshin-....sql.gz | docker exec -i sinshin-postgres psql -U sinshin -d sinshin
#   docker compose start api web
# 💡 بکاپ خارج از سرور (اختیاری): مقصد rclone + کلید عمومی age
#   (راهنمای کامل: docs/REFERENCE.md بخش ۱۰)
#BACKUP_RCLONE_REMOTE=b2:sinshin-backup
#BACKUP_AGE_PUBKEY=

# ─── ردیس (شبکه‌ی داخلی compose — دست نزن) ───
REDIS_URL=redis://redis:6379

# ─── اپ (compose مقادیر حساس بوت را خودش ست می‌کند) ───
APP_ENV=production
SESSION_TTL_DAYS=30

# ─── نقش‌ها و دستگاه ───
DEVICE_ENFORCEMENT=on
MAX_DEVICES_PER_USER=5

# ─── ضدتقلب دستگاه ───
DEVICE_LINK_THRESHOLD=0.7
DEVICE_AUTOBLOCK_SCORE=80
DEVICE_REFERRAL_BLOCK_AFTER=3
DEVICE_SIMILARITY_WINDOW_DAYS=7

# ─── OTP (پیش‌فرض = قرارداد فرانت) ───
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3
OTP_TTL_SECONDS=120
OTP_MAX_PER_HOUR=5
OTP_MAX_PER_DAY=20

# ─── 💡 مهلت‌های بیرونی (میلی‌ثانیه) ───
# هر فراخوانی HTTP به درگاه‌های پرداخت (زرین‌پال/پی‌ایر/سامان/ملت)
#PAYMENT_TIMEOUT_MS=15000
# فراخوانی درگاه پیامک (ارسال OTP و هشدار سلامت)
#SMS_TIMEOUT_MS=10000
# هر منبع بازه‌های IP دروازه‌ی جغرافیایی و فاصله‌ی تلاش مجددش (دقیقه)
#GEO_FETCH_TIMEOUT_MS=10000
#GEO_RETRY_MINUTES=15

# ─── سود معرفی ───
# درصد سود معرف از پرداخت آنلاینِ غذاها (بدون ارسال/بسته‌بندی).
# عدد صحیح ۰ تا ۱۰۰؛ صفر = خاموش. تغییرش فقط روی سفارش‌های جدید است.
#REFERRAL_PERCENT=10

# ─── اتصال‌های دیتابیس ───
# سقف اتصال‌های هم‌زمان هر نمونه‌ی API به پستگرس (با ریپلاها جمع می‌شود؛
# از سقف کلِ PG_MAX_CONNECTIONS پایین‌تر نگیر). برای ۸/۱۶: ۱۰ خوش‌بینانه،
# ۱۵ اگر ترافیک سنگین شد (REFERENCE بخش ۸).
#DB_POOL_MAX=10

# ─── زمان‌بندی کرون (تهران) ───
COUPON_SCAN_TIME=02:00
COUPON_NUDGE_TIME=11:00

# ─── هشدار پیامکی سلامت (قطعی/برگشت db/redis/uploads) ───
# خالی بگذاری = SUPER_ADMIN_PHONES گیرنده‌اند
#HEALTH_ALERT_PHONES=09121234567
#HEALTH_ALERT_EVERY_SECONDS=60
#HEALTH_ALERT_REPEAT_MINUTES=60

# ─── مختصات رستوران (مبدأ هزینه‌ی ارسال) ───
# سین‌شین — بندرانزلی، کیلومتر یک پاسداران.
# خالی = از تنظیمات پنل ادمین خوانده می‌شود.
RESTAURANT_LAT=37.4822056
RESTAURANT_LNG=49.4418273

# ─── نقشه نشان (دو کلید جدا) ───
# ۱) 💡 کلید web → فقط برای «نمایش نقشه» در مرورگر (SDK MapLibre).
#    موقع build وب داخل باندل می‌رود (compose می‌رساندش؛ بعد از تغییر:
#    docker compose up -d --build web).
#    در پنل نشان، بخش «دامنه‌های مجاز» این کلید را با دامنه سایتت پر کن:
#      sinshin-foodpark.ir
#      www.sinshin-foodpark.ir
#    خالی = فرم مختصات دستی جای نقشه — سایت کار می‌کند.
VITE_NESHAN_MAP_KEY=
# (نام قدیمی — اگر پر باشد به‌عنوان fallback خوانده می‌شود)
#VITE_NESHAN_API_KEY=

# ۲) 💡 کلید service → سرویس‌های REST (مسیریابی/ماتریس/آدرس معکوس)؛
#    فقط سمت سرور (هرگز وارد باندل وب نمی‌شود). IP سرور را در پنل
#    نشان whitelist کن (همان IP که به SMS.ir دادی).
#    خالی = فاصله‌ی هوایی (هیورساین) و خط مستقیم روی نقشه.
NESHAN_SERVICE_API_KEY=
# مهلت و کش پاسخ‌های نشان:
#NESHAN_TIMEOUT_MS=10000
#NESHAN_CACHE_TTL_SECONDS=300

# ─── سد «فقط ایران» ───
# IPهایی که بدون سد رد می‌شوند (با کاما) — برای VPN دفتر و…
#GEO_BYPASS_IPS=

# ─── 🔒 پوش نوتیفیکیشن — Web Push (اجباری در تولید) ───
# جفت‌کلید VAPID — یک‌بار بساز و برای همیشه نگه دار:
#   روی سیستم خودت:  cd apps/api && bun scripts/generate-vapid-keys.ts
#   روی سرور (بدون bun):
#     docker compose --profile seed run --rm --no-deps seed-deploy bun scripts/generate-vapid-keys.ts
# (خروجی را همین‌جا بگذار؛ چرخش کلید = پاک‌شدن همه‌ی اشتراک‌های پوش)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# شناسه‌ی تماس استاندارد VAPID (mailto) — اختیاری، پیش‌فرض همین:
#VAPID_SUBJECT=mailto:admin@sinshin-foodpark.ir
# عمر پیام روی سرور پوش مرورگر (ثانیه — حداکثر ۴ هفته)
#PUSH_TTL_SECONDS=86400
# سقف اشتراک پوش فعال هر کاربر (بیشترها خودکار غیرفعال می‌شوند)
#PUSH_MAX_SUBS_PER_USER=5

# ─── گزارش روزانه/هفتگی + لاگ داکر ───
# عمر توکن لینک گزارش (ساعت) — بعد از آن، لینک پیامک‌شده می‌میرد
#REPORT_TOKEN_TTL_HOURS=24
# سقف حجم لاگ داکر داخل بسته‌ی ZIP (مگابایت)
#REPORT_LOGS_MAX_MB=20
# جمع‌آوری لاگ داکر (نیاز به docker.sock مونت‌شده در compose)
#DOCKER_LOGS_ENABLED=on
# بعد از آرشیو، لاگ کانتینرها روی سرور truncate شود (پاک‌سازی روزانه)
#DOCKER_LOGS_TRUNCATE=on
# مسیر سوکت داکر داخل کانتینر api
#DOCKER_SOCKET=/var/run/docker.sock
# 🔚 gid گروه docker روی «میزبان» — این دستور را بزن و عددش را بگذار:
#   stat -c '%g' /var/run/docker.sock
# (پیش‌فرض 999 فقط حدس است؛ غلط باشد لاگ جمع نمی‌شود ولی همه‌چیز کار می‌کند)
DOCKER_GID=999

# ─── مترجم آفلاین NLLB (راز مشترک api ↔ translator) ───
# هدر x-translator-token؛ خالی = بدون توکن (مثل قبل)
# بساز:  openssl rand -hex 24
#TRANSLATOR_TOKEN=

# ─── سرویس تست زرین‌پال (سندباکس رسمی) ───
# true = فقط هاست به sandbox.zarinpal.com عوض می‌شود؛ مسیرها و جریان
# verify یکسان‌اند و پول واقعی جابه‌جا نمی‌شود. مرچنت آیدی هر UUID
# دلخواهی قبول می‌شود. در production بوت را می‌کُشد (ممنوع عمدی).
#ZARINPAL_SANDBOX=false

# ─── آپلود (volume کانتینر — دست نزن) ───
UPLOAD_DIR=/data/uploads

# ─── 💡 تیونینگ زیرساخت — کالیبره‌ی پایه برای ۸ هسته/۱۶GB ───
# این مقادیر فعال‌اند و معقول‌اند. اگر خواستی از ۱۶ گیگ «کامل» استفاده
# کنی (پیک‌های سنگین): نسخه‌ی تهاجمی در REFERENCE بخش ۸ آمده.
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=8MB
# سقف حافظه‌ی ردیس (سیاست noeviction است — داده‌ی OTP/نشست بیرون نمی‌رود)
#REDIS_MAXMEMORY=512mb

# ─── لبه و توکن‌ها ───
API_UPSTREAMS=api:3000
SWAGGER_ENABLED=false
# هدر HSTS در Caddy فقط وقتی true (بعد از اطمینان از پایداری HTTPS)
#HSTS_ENABLED=false
# عمر access token بر حسب دقیقه (refresh بی‌اثر نیست — این فقط توکن کوتاه‌عمر است)
#ACCESS_TOKEN_TTL_MINUTES=15

# ─── مغایرت‌گیری مالی ───
# auto-fix چک‌ها (پیش‌فرض همه off = فقط گزارش). R1 تنها چکِ قابل
# auto است که درست می‌کند؛ بقیه فقط با پرچم روی می‌شوند و همان
# رفتار R1 را دارند — بدون تأیید روشن نکن.
RECONCILE_AUTO_R1=off
#RECONCILE_AUTO_R2=off
#RECONCILE_AUTO_R3=off
#RECONCILE_AUTO_R4=off
#RECONCILE_AUTO_R5=off
#RECONCILE_AUTO_R6=off
#RECONCILE_AUTO_R7=off
#RECONCILE_AUTO_R8=off
#RECONCILE_AUTO_R9=off
#RECONCILE_AUTO_R10=off
# پنجره‌ی چک برداشت کیف پول (روز)
#RECONCILE_R3_WINDOW_DAYS=120