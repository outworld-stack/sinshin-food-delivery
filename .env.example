# ══════════════════════════════════════════════════════════════
# سین‌شین — نمونه‌ی متغیرهای فایل .env روت (برای compose)
# کپی کن به .env و مقدارها را عوض کن.
#
# ⚠️ تا اتمام phase-1: SMS_PROVIDER=console و GATEWAY_MODE=mock
#    در کنار APP_ENV=production ممنوع (باگ‌های OTP/MOCK).
# ══════════════════════════════════════════════════════════════

# ─── دامنه و لبه ───
DOMAIN=sinshin.localhost
ACME_EMAIL=dev@sinshin.localhost
SWAGGER_ENABLED=false

# ─── پستگرس ───
POSTGRES_USER=sinshin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sinshin
DATABASE_URL=postgres://sinshin:CHANGE_ME@postgres:5432/sinshin

# ─── بکاپ روزانه‌ی دیتابیس (سرویس backup در compose) ───
# ساعت اجرا به وقت تهران (۵ صبح = بعد از job نگهداشت ۰۴:۳۰)
BACKUP_HOUR=5
# تعداد نسخه‌ای که نگه داشته می‌شود (۷ = یک هفته)
BACKUP_KEEP=7
# بازیابی:
#   podman volume inspect sinshin_backups_data   ← مسیر فایل‌ها روی هاست
#   gunzip -c sinshin-....sql.gz | podman exec -i sinshin-postgres \
#     psql -U sinshin -d sinshin

# ─── ردیس ───
REDIS_URL=redis://redis:6379

# ─── اپ ───
APP_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# تولید کن: openssl rand -base64 48  (اجباری در production)
JWT_SECRET=
SITE_URL=https://sinshin.localhost
SESSION_TTL_DAYS=30
ACCESS_TOKEN_TTL_MINUTES=15

# ─── نقش‌ها و دستگاه ───
SUPER_ADMIN_PHONES=09120000000
DEVICE_ENFORCEMENT=on
MAX_DEVICES_PER_USER=5

# ─── ضدتقلب دستگاه ───
DEVICE_LINK_THRESHOLD=0.7
DEVICE_AUTOBLOCK_SCORE=80
DEVICE_REFERRAL_BLOCK_AFTER=3
DEVICE_SIMILARITY_WINDOW_DAYS=7

# ─── پیامک (console = فقط لاگ؛ در production پذیرفته نمی‌شود) ───
SMS_PROVIDER=console
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER=

# ─── OTP ───
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3
OTP_TTL_SECONDS=120
OTP_MAX_PER_HOUR=5
OTP_MAX_PER_DAY=20

# ─── زمان‌بندی کرون (تهران) ───
COUPON_SCAN_TIME=02:00
COUPON_NUDGE_TIME=11:00

# ─── لود بالانسر ───
API_UPSTREAMS=api:3000

# ─── درگاه پرداخت (mock فقط برای توسعه) ───
GATEWAY_MODE=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK=
PAYIR_API_KEY=
SEP_TERMINAL_ID=

# ─── آپلود ───
UPLOAD_DIR=/data/uploads

# ─── Reconcile ───
RECONCILE_AUTO_R1=off