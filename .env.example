# ═══════════════════════════════════════════════════════════════
# round-49 — sinshin-food-delivery — فایل 2 از 6
# مسیر مقصد: .env.example
# وضعیت: جایگزینی کامل فایل موجود
# کامیت پیشنهادی: stage forty-three
# ═══════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════
# سین‌شین — فایل کانفیگ تولید (تک‌فایل)
# کپی کن:  cp .env.example .env
#
# این تنها فایلی است که docker compose می‌خواند (سرویس‌های
# api / migrate / seed / postgres / backup در استک تولید).
# راهنمای گام‌به‌گام کامل توسعه و تولید: README.md (بخش ۲ و ۳).
#
# ⚠ سرویس api با مقدار غلط/ناقص بوت نمی‌شود (fail-fast عمدی)
#   و در لاگ دقیقاً می‌گوید چه چیزی را اصلاح کنی.
# ══════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════
# ۱) اجباری — بدون این‌ها تولید بالا نمی‌آید
# ══════════════════════════════════════════════════════════════

# ─── دامنه (بدون https:// — Caddy با همین نام TLS می‌گیرد) ───
# دامنه‌ی اصلی با پیشوند؛ دامنه‌ی بدون پیشوند فقط ریدایرکت می‌شود.
DOMAIN=www.sinshin-foodpark.ir
APEX_DOMAIN=sinshin-foodpark.ir
# ایمیلی که Let's Encrypt برای گواهی می‌فرستد — روی سرور واقعی کن
ACME_EMAIL=dev@sinshin.localhost

# ─── پستگرس ───
POSTGRES_USER=sinshin
# پسورد دیتابیس — بساز: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sinshin
# ⚠ باید همان پسورد بالا داخلش باشد (user/db هم هماهنگ):
DATABASE_URL=postgres://sinshin:CHANGE_ME@postgres:5432/sinshin

# ─── امنیت نشست‌ها ───
# کلید امضای توکن‌های ورود — بساز: openssl rand -base64 48
# (حداقل ۳۲ کاراکتر؛ لو رفتنش یعنی جعل نشست)
JWT_SECRET=

# ─── ادمین‌ها ───
# شماره‌هایی که با اولین ورود ابرمدیر می‌شوند (با کاما جدا).
# خالی = پنل ادمین عملاً بی‌صاحب می‌ماند.
SUPER_ADMIN_PHONES=09118067283,09039526091

# ─── پیامک OTP (اجباری در تولید) ───
# فقط دو مقدار مجاز:  console (فقط لاگ، ممنوع در تولید)  |  real
# قرارداد درگاه real:  POST {SMS_BASE_URL}/send
#   هدر:  Authorization: Bearer {SMS_API_KEY}
#   بدنه: {"from": "<SMS_SENDER>", "to": "<شماره>", "text": "<متن>"}
# هر پنل پیامکی که همین قرارداد را بدهد قابل نصب است؛
# اگر پنل تو شکل دیگری دارد، آداپتور باید متناسب شود (به من بگو).
SMS_PROVIDER=console
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER=

# ─── درگاه پرداخت (اجباری در تولید) ───
# GATEWAY_MODE فقط «فعال/غیرفعال بودن درگاه واقعی» را تعیین می‌کند؛
# انتخابِ درگاه در صفحه‌ی تسویه توسط مشتری است:
#   direct یا indirect = درگاه واقعی فعال (هر دو یکسان عمل می‌کنند)
#   mock               = فقط توسعه — در تولید بوت را می‌کُشد
# چهار درگاه آماده است؛ کلید هر کدام را که ارائه می‌کنی بده:
#   زرین‌پال          → ZARINPAL_MERCHANT_ID (کد ۳۶ کاراکتری پنل زرین‌پال)
#   پی‌ایر            → PAYIR_API_KEY (کلید پنل پی‌ایر)
#   بانک سامان        → SEP_TERMINAL_ID (کد ترمینال ۸ رقمی از پنل sep.ir)
#   بانک ملت          → MELLAT_TERMINAL_ID + MELLAT_USERNAME + MELLAT_PASSWORD
#                       (از پنل به‌پرداخت بعد از فعال‌سازی ترمینال)
# نکته: آدرس برگشت همه‌ی درگاه‌ها خودکار از DOMAIN ساخته می‌شود؛ در پنل
# زرین‌پال آدرس سایت را ثبت کن تا callback رد نشود.
# تست بدون پول: زرین‌پال سندباکس رسمی دارد (ZARINPAL_SANDBOX در بخش ۲)؛
# پی‌ایر با کلید test؛ سامان/ملت (شاپرک) سندباکس عمومی ندارند — ترمینال
# تستیِ بانک روی همان آدرس تولید. شرح کامل: README بند ۴-۲.
GATEWAY_MODE=mock
ZARINPAL_MERCHANT_ID=
PAYIR_API_KEY=
SEP_TERMINAL_ID=
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=

# ══════════════════════════════════════════════════════════════
# ۲) اختیاری — پیش‌فرض معقول دارند؛ فقط اگر خواستی عوض کن
# ══════════════════════════════════════════════════════════════

# ─── بکاپ روزانه‌ی دیتابیس (سرویس backup) ───
# ساعت اجرا به وقت تهران (۵ صبح = بعد از job نگهداشت ۰۴:۳۰)
BACKUP_HOUR=5
# تعداد نسخه‌ای که نگه داشته می‌شود (۷ = یک هفته)
BACKUP_KEEP=7
# بازیابی:
#   docker volume inspect sinshin_backups_data   ← مسیر فایل‌ها روی هاست
#   gunzip -c sinshin-....sql.gz | docker exec -i sinshin-postgres \
#     psql -U sinshin -d sinshin

# ─── ردیس (شبکه‌ی داخلی compose — دست نزن) ───
REDIS_URL=redis://redis:6379

# ─── اپ (compose مقادیر حساس بوت را خودش ست می‌کند) ───
APP_ENV=production
SESSION_TTL_DAYS=30

# ─── نقش‌ها و دستگاه ───
DEVICE_ENFORCEMENT=on
MAX_DEVICES_PER_USER=5

# ─── ضدتقلب دستگاه ───
DEVICE_LINK_THRESHOLD=0.7
DEVICE_AUTOBLOCK_SCORE=80
DEVICE_REFERRAL_BLOCK_AFTER=3
DEVICE_SIMILARITY_WINDOW_DAYS=7

# ─── OTP (پیش‌فرض = قرارداد فرانت) ───
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3
OTP_TTL_SECONDS=120
OTP_MAX_PER_HOUR=5
OTP_MAX_PER_DAY=20

# ─── مهلت‌های بیرونی (رارد ۴۵ — میلی‌ثانیه؛ پیش‌فرض = مقادیر قبلی) ───
# هر فراخوانی HTTP به درگاه‌های پرداخت (زرین‌پال/پی‌ایر/سامان/ملت)
#PAYMENT_TIMEOUT_MS=15000
# فراخوانی درگاه پیامک (ارسال OTP و هشدار سلامت)
#SMS_TIMEOUT_MS=10000
# هر منبع بازه‌های IP دروازه‌ی جغرافیایی و فاصله‌ی تلاش مجددش (دقیقه)
#GEO_FETCH_TIMEOUT_MS=10000
#GEO_RETRY_MINUTES=15

# ─── سود معرفی (رارد ۴۵) ───
# درصد سود معرف از پرداخت آنلاینِ غذاها (بدون ارسال/بسته‌بندی).
# عدد صحیح ۰ تا ۱۰۰؛ صفر = خاموش. تغییرش فقط روی سفارش‌های جدید است.
#REFERRAL_PERCENT=10

# ─── اتصال‌های دیتابیس (رارد ۴۵) ───
# سقف اتصال‌های هم‌زمان هر نمونه‌ی API به پستگرس (با ریپلاها جمع می‌شود؛
# از سقف کلِ PG_MAX_CONNECTIONS پایین‌تر نگیر).
#DB_POOL_MAX=10

# ─── زمان‌بندی کرون (تهران) ───
COUPON_SCAN_TIME=02:00
COUPON_NUDGE_TIME=11:00

# ─── هشدار پیامکی سلامت (قطعی/برگشت db/redis/uploads) ───
# خالی بگذاری = SUPER_ADMIN_PHONES گیرنده‌اند
#HEALTH_ALERT_PHONES=09121234567
#HEALTH_ALERT_EVERY_SECONDS=60
#HEALTH_ALERT_REPEAT_MINUTES=60

# ─── مختصات رستوران (مبدأ هزینه‌ی ارسال) ───
# سین‌شین — بندرانزلی، کیلومتر یک پاسداران.
# خالی = از تنظیمات پنل ادمین خوانده می‌شود.
RESTAURANT_LAT=37.4822056
RESTAURANT_LNG=49.4418273

# ─── نقشهٔ نشان (رارد ۴۹ — سومین چیزهایی که خودت می‌دهی) ───
# کلید سرویس نقشه برای انتخاب آدرس در تسویه. این کلید «موقع build وب»
# داخل باندل می‌رود؛ compose آن را از همین فایل به مرحله‌ی build
# سرویس web می‌رساند (بعد از تغییرش: docker compose up -d --build web).
# خالی/حذف = فرم مختصات دستی جای نقشه را می‌گیرد — سایت کار می‌کند.
# کلید رایگان: https://platform.neshan.org
#VITE_NESHAN_API_KEY=

# ─── سد «فقط ایران» ───
# IPهایی که بدون سد رد می‌شوند (با کاما) — برای VPN دفتر و…
#GEO_BYPASS_IPS=

# ─── سرویس تست زرین‌پال (رارد ۴۵ — سندباکس رسمی) ───
# true = فقط هاست به sandbox.zarinpal.com عوض می‌شود؛ مسیرها و جریان
# verify یکسان‌اند و پول واقعی جابه‌جا نمی‌شود. مرچنت آیدی هر UUID
# دلخواهی قبول می‌شود. در production بوت را می‌کُشد (ممنوع عمدی).
#ZARINPAL_SANDBOX=false

# ─── مترجم آفلاین NLLB (round-35) ───
# سرویس translator در compose خودش این آدرس را دارد؛ فقط اگر می‌خواهی
# جای دیگری باشد عوضش کن. پایین/خاموش بودن مترجم فقط صف ترجمه را
# نگه می‌دارد — سایت و پنل کار می‌کنند.
#TRANSLATOR_URL=http://translator:8300

# ─── آپلود (volume کانتینر — دست نزن) ───
UPLOAD_DIR=/data/uploads

# ─── تیونینگ زیرساخت (رارد ۴۵ — پیش‌فرض‌ها = مقادیر قبلی، برای ۴ هسته/۸GB) ───
# پستگرس (فرمان سرویس postgres در compose) — فقط اگر اندازه‌ی سرورت
# با کالیبره‌ی پیش‌فرض فرق دارد عوض کن:
#PG_MAX_CONNECTIONS=200
#PG_SHARED_BUFFERS=256MB
#PG_EFFECTIVE_CACHE_SIZE=768MB
#PG_WORK_MEM=8MB
# سقف حافظه‌ی ردیس (سیاست noeviction است — داده‌ی OTP/نشست بیرون نمی‌رود)
#REDIS_MAXMEMORY=512mb

# ─── لبه و توکن‌ها ───
API_UPSTREAMS=api:3000
SWAGGER_ENABLED=false
# هدر HSTS در Caddy فقط وقتی true (بعد از اطمینان از پایداری HTTPS)
#HSTS_ENABLED=false
# عمر access token بر حسب دقیقه (refresh بی‌اثر نیست — این فقط توکن کوتاه‌عمر است)
#ACCESS_TOKEN_TTL_MINUTES=15

# ─── مغایرت‌گیری مالی ───
# auto-fix چک‌ها (پیش‌فرض همه off = فقط گزارش). R1 تنها چکِ قابل
# auto است که درست می‌کند؛ بقیه فقط با پرچم روی می‌شوند و همان
# رفتار R1 را دارند — بدون تأیید روشن نکن.
RECONCILE_AUTO_R1=off
#RECONCILE_AUTO_R2=off
#RECONCILE_AUTO_R3=off
#RECONCILE_AUTO_R4=off
#RECONCILE_AUTO_R5=off
#RECONCILE_AUTO_R6=off
#RECONCILE_AUTO_R7=off
#RECONCILE_AUTO_R8=off
#RECONCILE_AUTO_R9=off
#RECONCILE_AUTO_R10=off
# پنجره‌ی چک برداشت کیف پول (روز)
#RECONCILE_R3_WINDOW_DAYS=120