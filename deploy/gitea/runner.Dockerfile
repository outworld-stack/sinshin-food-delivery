# ایمیج رانر CI/CD — ایمیج رسمی act_runner به‌علاوه‌ی ابزارهایی که
# workflow استقرار لازم دارد: docker و docker compose و curl.
# (‏git و bash از قبل داخل ایمیج رسمی هست.)
#
# حالت host ابزارها را از کانتینر رانر می‌خواهد؛ ایمیج رسمی آن‌ها را
# ندارد — پس همین‌جا نصبشان می‌کنیم: یک‌بار در بیلد، نه در هر job.
# ═══════════════════════════════════════════════════════════════

FROM gitea/act_runner:0.6.1

RUN apk add --no-cache docker-cli docker-cli-compose curl
