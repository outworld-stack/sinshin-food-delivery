# ═══════════════════════════════════════════════════════════════
# round-50 — sinshin-food-delivery — فایل 8 از 10
# مسیر مقصد: deploy/gitea/.env.example
# وضعیت: فایل جدید
# کامیت پیشنهادی: stage forty-four
# ═══════════════════════════════════════════════════════════════
# ═══════════════════════════════════════════════════════════════
# کانفیگ استک گیتا — جدا از ‎.env اصلی پروژه
# کپی کن:  cp deploy/gitea/.env.example deploy/gitea/.env
# ═══════════════════════════════════════════════════════════════

# IP عمومی سرور (بدون پورت) — برای آدرس‌های clone که گیتا در
# رابط وب نشان می‌دهد. گام ۴ README.
SERVER_IP=203.0.113.10

# توکن ثبت رانر — از: مدیریت سایت ← Actions ← Runners ← Create Token
# (گام ۵ README). تا نگذاری، رانر فقط تلاشِ ثبت را تکرار می‌کند.
GITEA_RUNNER_REGISTRATION_TOKEN=NOT-SET-YET
