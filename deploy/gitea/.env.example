# ═══════════════════════════════════════════════════════════════
# stage-57 — sinshin-food-delivery — فاز دیپلوی
# مسیر مقصد: deploy/gitea/.env.example
# وضعیت: جایگزینی کامل فایل موجود
# کامیت پیشنهادی: stage fifty-seven
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# کانفیگ استک گیتا — جدا از ‎.env اصلی پروژه
# کپی کن:  cp deploy/gitea/.env.example deploy/gitea/.env
#
# ⚠ این فایل همان چیزی است که docker compose موقع اجرای
#   docker-compose.yml همین پوشه برای جایگزینی متغیرها می‌خواند —
#   بدون GIT_DOMAIN استک بالا نمی‌آید (پیام خطای واضح می‌دهد).
# ═══════════════════════════════════════════════════════════════

# 🔒 زیردامنه‌ی گیتا (بدون https://) — اجباری.
# باید «عینِ» مقدار GIT_DOMAIN در ‎.env ریشه باشد (که caddy با آن
# HTTPS می‌گیرد). رکورد DNS: نوع A، نام git، مقدار IP سرور (README گام ۷).
GIT_DOMAIN=git.sinshin-foodpark.ir

# 🔒 توکن ثبت رانر — از: مدیریت سایت ← Actions ← Runners ← Create Token
# (README گام ۵). تا نگذاری، رانر فقط تلاشِ ثبت را تکرار می‌کند و
# استک اصلی دست نمی‌خورد.
GITEA_RUNNER_REGISTRATION_TOKEN=NOT-SET-YET

# (تغییر استیج-۵۷) SERVER_IP حذف شد — رابط وب گیتا دیگر روی IP:3000
# سرو نمی‌شود بلکه فقط از پشت caddy با HTTPS روی همین زیردامنه بالا
# می‌آید و cloneها هم با SSH (پورت 2222) ساخته می‌شوند.