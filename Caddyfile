# ═══════════════════════════════════════════════════════════════
# round-50 — sinshin-food-delivery — فایل 3 از 10
# مسیر مقصد: Caddyfile
# وضعیت: جایگزینی کامل فایل موجود
# کامیت پیشنهادی: stage forty-four
# ═══════════════════════════════════════════════════════════════
{
    email {$ACME_EMAIL:dev@sinshin.localhost}
}

# ── دامنه‌ی بدون پیشوند — همیشه به‌صورت دائمی به دامنه‌ی اصلی هدایت می‌شود ──
{$APEX_DOMAIN:sinshin.localhost} {
    redir https://{$DOMAIN:www.sinshin.localhost}{uri} permanent
}

{$DOMAIN:www.sinshin.localhost} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # HSTS فقط وقتی صراحتاً فعال شده باشد.
    @hsts expression `{env.HSTS_ENABLED} == "true"`
    header @hsts {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    # ── Swagger / OpenAPI ──────────────────────────────────
    @docs expression `{env.SWAGGER_ENABLED} == "true"`

    handle /swagger* {
        route {
            reverse_proxy @docs api:3000
            respond 404
        }
    }

    handle /openapi* {
        route {
            reverse_proxy @docs api:3000
            respond 404
        }
    }

    # ── Service Worker ─────────────────────────────────────
    handle /sw.js {
        header Cache-Control "no-cache, no-store, must-revalidate"
        reverse_proxy web:3000
    }

    # ── Web App Manifest ───────────────────────────────────
    handle /manifest.webmanifest {
        header Cache-Control "no-cache"
        reverse_proxy web:3000
    }

    # ── API ────────────────────────────────────────────────
    handle /api/* {
        # رارد M18 — هدرهای امنیتی روی پاسخ‌های API
        header {
            +Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
            X-Content-Type-Options nosniff
            Referrer-Policy no-referrer
        }

        reverse_proxy {$API_UPSTREAMS:api:3000} {
            lb_policy round_robin

            health_uri /api/health
            health_interval 15s
            health_timeout 5s

            lb_try_duration 5s

            flush_interval -1

            # رارد M18 — سقف‌های انتظار: هدر پاسخِ کند = قطع (نه معلق ابدی).
            # SSE با flush_interval -1 استریم فعال دارد و بعد از هدر اولیه
            # از این سقف‌ها عبور نمی‌کند.
            transport {
                read_timeout 60s
                response_header_timeout 15s
            }
        }
    }

    # ── Uploads ────────────────────────────────────────────
    handle /uploads/* {
        reverse_proxy {$API_UPSTREAMS:api:3000} {
            lb_policy round_robin

            health_uri /api/health
            health_interval 15s
            health_timeout 5s
        }
    }

    # ── Web ────────────────────────────────────────────────
    handle {
        reverse_proxy web:3000
    }
}

# ── گیتا — رارد C3: HTTPS فعال شد (قبلاً کامنت بود و پنل گیتا روی
# HTTP خامِ اینترنت‌روشن سرو می‌شد = سرقت اعتبارنامه). گیتا حالا فقط
# روی 127.0.0.1:3000 گوش می‌دهد (deploy/gitea/docker-compose.yml).
# گام‌های تکمیلی اگر هنوز انجام نشده:
#   ۱) رکورد DNS:  نوع A، نام git، مقدار IP سرور
#   ۲) در ‎.env ریشه:  GIT_DOMAIN=git.sinshin-foodpark.ir
#   ۳) ‎docker compose restart caddy
#   ۴) گیتا با ROOT_URL=https همان زیردامنه recreate شود
#      (deploy/gitea/docker-compose.yml همین پکیج).
{$GIT_DOMAIN:git.sinshin.localhost} {
    encode zstd gzip
    reverse_proxy gitea:3000
}
