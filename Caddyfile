# round-50 — sinshin-food-delivery — فایل 3 از 10
# مسیر مقصد: Caddyfile
# وضعیت: جایگزینی کامل فایل موجود
# کامیت پیشنهادی: stage forty-four
# ═══════════════════════════════════════════════════════════════
{
    email {$ACME_EMAIL:dev@sinshin.localhost}
}

# ── دامنه‌ی بدون پیشوند — همیشه به‌صورت دائمی به دامنه‌ی اصلی هدایت می‌شود ──
{$APEX_DOMAIN:sinshin.localhost} {
    redir https://{$DOMAIN:www.sinshin.localhost}{uri} permanent
}

{$DOMAIN:www.sinshin.localhost} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # HSTS فقط وقتی صراحتاً فعال شده باشد.
    @hsts expression `{env.HSTS_ENABLED} == "true"`
    header @hsts {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    # ── Swagger / OpenAPI ──────────────────────────────────
    @docs expression `{env.SWAGGER_ENABLED} == "true"`

    handle /swagger* {
        route {
            reverse_proxy @docs api:3000
            respond 404
        }
    }

    handle /openapi* {
        route {
            reverse_proxy @docs api:3000
            respond 404
        }
    }

    # ── Service Worker ─────────────────────────────────────
    handle /sw.js {
        header Cache-Control "no-cache, no-store, must-revalidate"
        reverse_proxy web:3000
    }

    # ── Web App Manifest ───────────────────────────────────
    handle /manifest.webmanifest {
        header Cache-Control "no-cache"
        reverse_proxy web:3000
    }

    # ── API ────────────────────────────────────────────────
    handle /api/* {
        reverse_proxy {$API_UPSTREAMS:api:3000} {
            lb_policy round_robin

            health_uri /api/health
            health_interval 15s
            health_timeout 5s

            lb_try_duration 5s

            flush_interval -1
        }
    }

    # ── Uploads ────────────────────────────────────────────
    handle /uploads/* {
        reverse_proxy {$API_UPSTREAMS:api:3000} {
            lb_policy round_robin

            health_uri /api/health
            health_interval 15s
            health_timeout 5s
        }
    }

    # ── Web ────────────────────────────────────────────────
    handle {
        reverse_proxy web:3000
    }
}

# ── گیتا (اختیاری — HTTPS روی پنل گیتا) ─────────────────────
# استک گیتا (deploy/gitea) رابط وب را روی پورت 3000 با HTTP سرو
# می‌کند و push هم با SSH روی 2222 امن است. این بلوک فقط برای آن
# روز است که خواستی رابط وب گیتا هم HTTPS شود:
#   ۱) رکورد DNS:  نوع A، نام git، مقدار IP سرور
#   ۲) در ‎.env ریشه:  GIT_DOMAIN=git.sinshin-foodpark.ir
#   ۳) این بلوک را از کامنت خارج کن و caddy را ری‌استارت کن:
#      ‎docker compose restart caddy
#   ۴) در ‎deploy/gitea/.env مقدار ROOT_URL را هم به آدرس https
#      همان زیردامنه تغییر بده و گیتا را recreate کن.
#
# {$GIT_DOMAIN:git.sinshin.localhost} {
#     encode zstd gzip
#     reverse_proxy gitea:3000
# }
