# ═════════════════════════════════════════════════════════════════════════════
#  Sinshin Foodpark — نمونه‌ی تنظیمات بک‌اند
#  نام فایل:  apps/api/.env.example
#  کپی کن:    cp apps/api/.env.example apps/api/.env
#             (بعد مقادیر CHANGE_ME_* را حتماً عوض کن)
#
#  این فایل مالِ حالت کانتینری است — compose.yml سرویس‌های api و
#  migrate و postgres آن را با env_file می‌خوانند.
#
#  برای اجرای اپ روی خود سیستم (بدون کانتینر) → انتهای همین فایل را ببین:
#  فایل apps/api/.env.local با اولویت بالاتر این مقادیر را override می‌کند.
#
#  مرجع کد:  apps/api/src/core/env.ts      ← تنظیمات زنده‌ی فعلی
#            apps/api/src/config/env.ts    ← کلاس AppConfig (فاز بعدی)
# ═════════════════════════════════════════════════════════════════════════════


# ─── دیتابیس (PostgreSQL) ───────────────────────────────────────────────────
# سه متغیر اول را خودِ کانتینر postgres می‌خواند (ساخت کاربر و دیتابیس).
# ⚠ اگر دیتابیس از قبل داری، پسورد همان بماند که هست.
POSTGRES_USER=sinshin
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=sinshin

# رشته‌ی اتصال — سرویس‌های api و migrate و دستور drizzle-kit آن را می‌خوانند.
# در شبکه‌ی کانتینری اسم سرویس (postgres) جای hostname می‌نشیند.
# ⚠ باید با سه متغیر بالا هم‌خوان باشد.
DATABASE_URL=postgres://sinshin:CHANGE_ME_STRONG@postgres:5432/sinshin


# ─── Redis (کش OTP و نشست‌ها) ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379


# ─── اپلیکیشن ────────────────────────────────────────────────────────────────
# development یا production
#   compose در حالت استقرار، این را صریحاً روی production می‌گذارد.
#   در production کد OTP دیگر در پاسخ API برنمی‌گردد (مگر SMS_PROVIDER=console).
APP_ENV=development

# پورت شنونده‌ی بک‌اند (index.ts می‌خواندش؛ پیش‌فرض 3000)
#   در کانتینر توسط compose روی 3000 قفل می‌شود — دست نزن.
PORT=3000

# آدرس عمومی سایت — برای ساخت لینک (مثل لینک پرداخت) به کار می‌آید.
#   در حالت کانتینری توسط compose بازنویسی می‌شود: https://${DOMAIN}
SITE_URL=http://localhost:3000


# ─── امنیت و نشست‌ها ─────────────────────────────────────────────────────────
# کلید امضای JWT — با این دستور بساز:
#   openssl rand -hex 32
# ⚠ هرگز پیش‌فرض/خالی نگذار؛ با لو رفتنش همه‌ی توکن‌ها جعل‌پذیر می‌شوند.
JWT_SECRET=CHANGE_ME_64_HEX_CHARS

# عمر refresh token بر حسب روز (پیش‌فرض 30)
#   access token خودش ۱۵ دقیقه است و از env قابل تغییر نیست.
SESSION_TTL_DAYS=30


# ─── قواعد دستگاه (یک دستگاه = یک ثبت‌نام) ──────────────────────────────────
# on یا off
#   خالی بگذاری → خودکار: در production روشن، در dev خاموش.
#   compose در حالت استقرار صریحاً on می‌گذارد؛
#   برای تست prod بدون محدودیت، موقتاً در compose آن را off کن.
DEVICE_ENFORCEMENT=off

# سقف دستگاه‌های فعال هر کاربر (پیش‌فرض 5)
MAX_DEVICES_PER_USER=5

# ابرمدیرها: با کاما جدا کن — از محدودیت دستگاه معاف‌اند و
# نقش superadmin می‌گیرند (نرمال‌سازی رقم‌ها خودکار است).
SUPER_ADMIN_PHONES=09121110001,09121110002,09122220003,09122220004


# ─── پیامک (OTP) ─────────────────────────────────────────────────────────────
# خالی یا console → کد در لاگ چاپ می‌شود (پنل SMS لازم ندارد؛
#   در dev کد در پاسخ API هم برمی‌گردد).
# kavenegar یا smsir → آداپتور واقعی (فاز بعدی؛ فعلاً خطا می‌دهد در production)
# ⚠ روی سرور واقعی هرگز console نگذار.
SMS_PROVIDER=console


# ─── ناحیه‌های ارسال (round-13) ──────────────────────────────────────────────
# مختصات رستوران — «مبدأ» محاسبه‌ی فاصله‌ی آدرس مشتری (هیورساین) برای
# تعیین ناحیه‌ی ارسال و هزینه‌ی پیک. هر دو باید معتبر باشند تا اعمال شوند.
# مثال (تهران، میدان آزادی): RESTAURANT_LAT=35.6997  RESTAURANT_LNG=51.3381
# اگر خالی بگذاری: کلید restaurant_location جدول settings (پیش‌فرض تهران).
# ⚠ مثل بقیه‌ی متغیرها فقط با ری‌استارت اعمال می‌شود.
#RESTAURANT_LAT=35.6997
#RESTAURANT_LNG=51.3381


# ─── فاز بعدی — فعلاً خوانده نمی‌شوند (کلاس AppConfig) ──────────────────────
# این‌ها را کلاس apps/api/src/config/env.ts می‌خواند که هنوز به index.ts
# وصل نشده؛ از حالا اینجا بگذاری، وقتی فاز بعدی فعال شد بی‌درنگ مصرف می‌شوند.

# گوش‌دادن روی همه‌ی اینترفیس‌ها (برای داخل کانتینر)
#HOST=0.0.0.0

# سطح لاگ: debug | info | warn | error
#LOG_LEVEL=info

# درگاه پیامک واقعی (به‌جای SMS_PROVIDER=console)
#SMS_BASE_URL=https://api.kavenegar.com/v1
#SMS_API_KEY=CHANGE_ME_IF_USING_REAL_SMS
#SMS_SENDER=10004346

# ساعت اجرای job ها — قالب HH:MM به وقت Asia/Tehran
# اسکن شبانه‌ی کمپین‌های کوپن
#COUPON_SCAN_TIME=02:00
# پیامک یادآوری قبل از ناهار
#COUPON_NUDGE_TIME=11:00

# مغایرت‌گیری مالی — پنجره‌ی چک R3 (برداشت کیف پول در برابر breakdown)
# به روز. یافته‌ها در reconcile_findings ماندگارند، پس پنجره فقط معیّن
# می‌کند «چقدر گذشته را دوباره ببینیم». پیش‌فرض ۱۲۰.
#RECONCILE_R3_WINDOW_DAYS=120

# ─── هشدار پیامکی سلامت (round-19) ──────────────────────────────────────────
# دیده‌بان داخلی، هر فاصلهٔ سنجش db/redis/uploads را با همان probe سلامت
# می‌سنجد؛ قطعیِ تأییدشده (۲ پروب پیاپی) و برگشت را پیامک می‌دهد و
# قطعیِ پایدار را هر repeatMinutes یادآوری می‌کند.
# گیرنده‌ها جدا با کاما؛ اگر خالی بگذاری = SUPER_ADMIN_PHONES (بدون کانفیگ اضافه).
#HEALTH_ALERT_PHONES=09121234567
# فاصله‌ی سنجش به ثانیه — پیش‌فرض ۶۰
#HEALTH_ALERT_EVERY_SECONDS=60
# یادآوری قطعیِ پایدار به دقیقه — پیش‌فرض ۶۰
#HEALTH_ALERT_REPEAT_MINUTES=60


# ─── نکته‌های ثابت (در کد hardcode شده و از env قابل تغییر نیستند) ──────────
#   کد OTP:        ۴ رقمی — هم‌قِد فرانت (login.tsx)؛ TTL ۱۲۰ ثانیه؛
#                  resend cooldown ۹۰ ثانیه؛ ۵ تلاش تأیید؛ ۵ کد در ساعت؛
#                  ۲۰ کد در روز برای هر شماره.
#   access token:  ۱۵ دقیقه.
#   cookie رفرش:   HttpOnly + SameSite=Lax (در prod روی Secure).


# ═════════════════════════════════════════════════════════════════════════════
#  اجرای اپ روی خود سیستم (حالت dev روزمره)؟
#
#  زیرساخت (postgres + redis) را با فایل dev بالا بیاور:
#    podman compose -f compose.dev.yml up -d
#
#  بعد کنار همین فایل، apps/api/.env.local بساز با این دو خط:
#
#    DATABASE_URL=postgres://sinshin:CHANGE_ME_STRONG@127.0.0.1:5432/sinshin
#    REDIS_URL=redis://127.0.0.1:6379
#
#  بقیه‌ی مقادیر از همین .env ارث می‌رسند؛ فقط آدرس‌ها عوض می‌شوند.
#  (تست‌شده: bun فایل .env.local را با اولویت بالاتر از .env می‌خواند.
#   گیت هم نگرانی ندارد — الگوی .env.* در .gitignore ریشه پوشیده است.)
# ═════════════════════════════════════════════════════════════════════════════