{
  "name": "sinshin-foodpark",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3001",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "build:pwa": "bun run build && bun scripts/build-sw.mjs && bun scripts/copy-sw.mjs",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "test:admin-day": "bun scripts/test-admin-day.ts",
    "test:printing": "bun scripts/test-print-agent.ts && bun scripts/test-print-document.ts && bun scripts/test-invoice-print-center.tsx && bun scripts/test-printer-discovery-client.ts",
    "test:admin2": "bun scripts/test-admin2-access.ts && bun scripts/test-admin2-live.tsx && bun scripts/test-admin2-forms.tsx",
    "test:maps": "bun scripts/test-neshan-sdk.ts && bun scripts/test-maps-client.tsx",
    "test:courier": "bun scripts/test-courier-client.ts",
    "test:receipt-canvas": "bun scripts/test-receipt-canvas.ts",
    "test:device": "bun scripts/test-device-fingerprint.ts",
    "test:fetch-timeout": "bun scripts/test-fetch-timeout.ts",
    "test:auth-session": "bun scripts/test-auth-session.ts",
    "test:auth-store": "bun scripts/test-auth-store.ts",
    "test:registration-client": "bun scripts/test-registration-client.ts",
    "test:sse-client": "bun scripts/test-sse-client.ts",
    "test:push-json-timeout": "bun scripts/test-push-json-timeout.ts",
    "test:push-lifecycle": "bun scripts/test-push-lifecycle.ts",
    "test:pwa-worker": "bun scripts/test-pwa-worker.ts",
    "test:notification-cache": "bun scripts/test-notification-cache.ts",
    "test:checkout-client": "bun scripts/test-checkout-client.tsx",
    "test:payment-retry": "bun scripts/test-payment-target.ts && bun scripts/test-payment-retry-client.tsx",
    "test:checkout-intent": "bun scripts/test-checkout-intent.ts",
    "test:referral-client": "bun scripts/test-referral-client.ts",
    "test:wallet-client": "bun scripts/test-wallet-client.tsx",
    "test:order-money-cache": "bun scripts/test-order-money-cache.ts",
    "test:products": "bun scripts/test-products-client.tsx",
    "test:articles": "bun scripts/test-articles-client.tsx && bun scripts/test-articles-api-client.ts && bun scripts/test-articles-admin.tsx && bun scripts/test-article-rendering.tsx"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@sinshin/shared": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "nitro": "3.0.260610-beta",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reicon-react": "^1.2.0",
    "swiper": "^14.1.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@napi-rs/canvas": "^1.0.11",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsqr": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.0.0",
    "workbox-build": "^7.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
